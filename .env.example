# Copy this file to .env and customize for your machine
# cp .env.example .env

# Tmux socket path
TMUX_SOCKET=/home/youruser/.tmux/default

# Your user ID (check with: id -u)
HOST_UID=1000

# Your group ID (check with: id -g)
HOST_GID=1000

# Your home directory
HOST_HOME=/home/youruser

# MySQL configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=tts_bot

# TTYD port ranges
TTYD_PORT_RANGE_DEV=16100-16200
TTYD_PORT_RANGE_PROD=15100-15300
