#!/bin/bash
# Tmux management CLI tool

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

cmd="$1"
shift

case "$cmd" in
  create)
    name="$1"
    if [ -z "$name" ]; then
      echo "Usage: tm create <name>"
      exit 1
    fi
    
    # Create new pane via API
    "$DIR/fast-api" /api/tmux/create "{\"win_name\":\"$name\",\"dev\":false}"
    ;;
    
  restart)
    pane_id="$1"
    if [ -z "$pane_id" ]; then
      echo "Usage: tm restart <pane_id|all>"
      exit 1
    fi
    
    if [ "$pane_id" = "all" ]; then
      # Restart all panes
      "$DIR/fast-api" /api/tmux/restart_all
    else
      # Restart single pane
      "$DIR/fast-api" /api/tmux/restart "{\"pane_id\":\"$pane_id\"}"
    fi
    ;;
    
  ttyd)
    subcmd="$1"
    case "$subcmd" in
      list)
        # List all ttyd processes
        echo "TTYD Processes:"
        ps aux | grep '[t]tyd' | awk '{print $2, $11, $12, $13, $14, $15}' | while read line; do
          pid=$(echo "$line" | awk '{print $1}')
          port=$(echo "$line" | grep -oP '\-p \K[0-9]+')
          echo "PID: $pid  Port: $port  Command: $line"
        done
        echo ""
        echo "Database Config:"
        "$DIR/fast-api" /api/ttyd/list
        ;;
      *)
        echo "Usage: tm ttyd <command>"
        echo ""
        echo "Commands:"
        echo "  list    List all ttyd processes and ports"
        exit 1
        ;;
    esac
    ;;
  
  help|--help|-h)
    echo "Usage: tm <command> [args]"
    echo ""
    echo "Commands:"
    echo "  create <name>         Create a new pane"
    echo "  restart <pane_id>     Restart a pane"
    echo "  restart all           Restart all active panes"
    echo "  ttyd list             List all ttyd processes and ports"
    echo "  help                  Show this help message"
    echo ""
    echo "Other available tools:"
    echo "  eng <text>            Correct English grammar with Chinese translation"
    echo "  gpt <prompt>          Quick GPT query"
    echo "  gpt-chat              Interactive GPT chat session"
    echo "  fast-api <endpoint>   Direct API call to fast-api server"
    exit 0
    ;;
    
  *)
    echo "Usage: tm <command> [args]"
    echo ""
    echo "Commands:"
    echo "  create <name>         Create a new pane"
    echo "  restart <pane_id>     Restart a pane"
    echo "  restart all           Restart all active panes"
    echo "  ttyd list             List all ttyd processes and ports"
    exit 1
    ;;
esac
