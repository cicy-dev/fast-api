"""OAuth authentication router"""
import os
from fastapi import APIRouter, Request, HTTPException, Depends
from fastapi.responses import RedirectResponse, JSONResponse
import pymysql
import time
from typing import Dict, Optional

# Lazy import OAuth to avoid dependency issues
try:
    from authlib.integrations.starlette_client import OAuth
    from itsdangerous import URLSafeTimedSerializer
    OAUTH_AVAILABLE = True
except ImportError:
    OAUTH_AVAILABLE = False

router = APIRouter(prefix="/api/auth", tags=["auth"])

# OAuth config (only if available)
if OAUTH_AVAILABLE:
    oauth = OAuth()

    oauth.register(
        name='google',
        client_id=os.getenv('GOOGLE_CLIENT_ID'),
        client_secret=os.getenv('GOOGLE_CLIENT_SECRET'),
        server_metadata_url='https://accounts.google.com/.well-known/openid-configuration',
        client_kwargs={'scope': 'openid email profile'}
    )

    oauth.register(
        name='github',
        client_id=os.getenv('GITHUB_CLIENT_ID'),
        client_secret=os.getenv('GITHUB_CLIENT_SECRET'),
        authorize_url='https://github.com/login/oauth/authorize',
        authorize_params=None,
        access_token_url='https://github.com/login/oauth/access_token',
        access_token_params=None,
        client_kwargs={'scope': 'user:email'}
    )

    # Session serializer
    serializer = URLSafeTimedSerializer(os.getenv('SECRET_KEY', 'dev-secret-key'))

def get_db():
    return _get_db_connection()

@router.get("/login/{provider}")
async def login(provider: str, request: Request):
    """Initiate OAuth login"""
    if provider not in ['google', 'github']:
        raise HTTPException(400, "Invalid provider")
    
    redirect_uri = request.url_for('auth_callback', provider=provider)
    return await oauth.create_client(provider).authorize_redirect(request, redirect_uri)

@router.get("/callback/{provider}")
async def auth_callback(provider: str, request: Request):
    """OAuth callback"""
    if provider not in ['google', 'github']:
        raise HTTPException(400, "Invalid provider")
    
    client = oauth.create_client(provider)
    token = await client.authorize_access_token(request)
    
    # Get user info
    if provider == 'google':
        user_info = token.get('userinfo')
        email = user_info.get('email')
        name = user_info.get('name')
        avatar = user_info.get('picture')
    else:  # github
        resp = await client.get('https://api.github.com/user', token=token)
        user_data = resp.json()
        email = user_data.get('email')
        name = user_data.get('name') or user_data.get('login')
        avatar = user_data.get('avatar_url')
    
    if not email:
        raise HTTPException(400, "Email not provided")
    
    # Save/update user in database
    conn = get_db()
    try:
        with conn.cursor() as c:
            c.execute("""
                INSERT INTO users (email, name, avatar, provider, last_login)
                VALUES (%s, %s, %s, %s, NOW())
                ON DUPLICATE KEY UPDATE
                    name=%s, avatar=%s, last_login=NOW()
            """, (email, name, avatar, provider, name, avatar))
            conn.commit()
            
            c.execute("SELECT id, email, name, avatar FROM users WHERE email=%s", (email,))
            user = c.fetchone()
    finally:
        conn.close()
    
    # Generate session token
    session_token = serializer.dumps({'user_id': user['id'], 'email': email})
    
    # Redirect to frontend with token
    frontend_url = os.getenv('FRONTEND_URL', 'http://localhost:3000')
    return RedirectResponse(f"{frontend_url}/auth/callback?token={session_token}")

@router.get("/me")
async def get_current_user(request: Request):
    """Get current user info from session token or API token"""
    auth_header = request.headers.get('Authorization', '')
    if not auth_header.startswith('Bearer '):
        raise HTTPException(401, "Not authenticated")
    
    token = auth_header[7:]
    
    # Try session token first
    try:
        data = serializer.loads(token, max_age=86400*30)  # 30 days
        conn = get_db()
        try:
            with conn.cursor() as c:
                c.execute("SELECT id, email, name, avatar, provider FROM users WHERE id=%s", (data['user_id'],))
                user = c.fetchone()
                if user:
                    return user
        finally:
            conn.close()
    except:
        pass
    
    # Try API token
    conn = get_db()
    try:
        with conn.cursor() as c:
            c.execute("""
                SELECT u.id, u.email, u.name, u.avatar, u.provider 
                FROM users u
                JOIN user_tokens t ON u.id = t.user_id
                WHERE t.token = %s AND t.is_active = 1 
                AND (t.expires_at IS NULL OR t.expires_at > NOW())
            """, (token,))
            user = c.fetchone()
            if not user:
                raise HTTPException(401, "Invalid token")
            
            # Update last_used
            c.execute("UPDATE user_tokens SET last_used=NOW() WHERE token=%s", (token,))
            conn.commit()
            return user
    finally:
        conn.close()

@router.post("/token")
async def create_token(request: Request):
    """Create API token for current user"""
    user = await get_current_user(request)
    
    import secrets
    token = secrets.token_hex(32)
    
    data = await request.json()
    name = data.get('name', 'API Token')
    expires_days = data.get('expires_days')
    
    conn = get_db()
    try:
        with conn.cursor() as c:
            if expires_days:
                c.execute("""
                    INSERT INTO user_tokens (user_id, token, name, expires_at)
                    VALUES (%s, %s, %s, DATE_ADD(NOW(), INTERVAL %s DAY))
                """, (user['id'], token, name, expires_days))
            else:
                c.execute("""
                    INSERT INTO user_tokens (user_id, token, name)
                    VALUES (%s, %s, %s)
                """, (user['id'], token, name))
            conn.commit()
            return {"token": token, "name": name}
    finally:
        conn.close()

@router.get("/tokens")
async def list_tokens(request: Request, auth: dict = Depends(require_api_full)):
    """List all tokens for current user"""
    user = await get_current_user(request)
    
    conn = get_db()
    try:
        with conn.cursor() as c:
            c.execute("""
                SELECT id, name, created_at, last_used, expires_at, is_active
                FROM user_tokens WHERE user_id=%s ORDER BY created_at DESC
            """, (user['id'],))
            return {"tokens": c.fetchall()}
    finally:
        conn.close()

@router.delete("/tokens/{token_id}")
async def delete_token(token_id: int, request: Request, auth: dict = Depends(require_api_full)):
    """Delete a token"""
    user = await get_current_user(request)
    
    conn = get_db()
    try:
        with conn.cursor() as c:
            c.execute("DELETE FROM user_tokens WHERE id=%s AND user_id=%s", (token_id, user['id']))
            conn.commit()
            return {"success": True}
    finally:
        conn.close()

@router.post("/logout")
async def logout():
    """Logout (client should delete token)"""
    return {"success": True, "message": "Logged out"}


# ============================================================================
# Token-based Authentication (Phase 1 - auth-design.md)
# ============================================================================

import time
from typing import Dict, Optional

# In-memory cache: {token: {perms, group_id, pane_id, expires_at, cached_at}}
_token_cache: Dict[str, dict] = {}
CACHE_TTL = 30  # seconds

def _get_db_connection():
    """Get MySQL connection using environment variables"""
    return pymysql.connect(
        host=os.getenv("MYSQL_HOST", "127.0.0.1"),
        port=int(os.getenv("MYSQL_PORT", "3306")),
        user=os.getenv("MYSQL_USER", "root"),
        password=os.getenv("MYSQL_PASSWORD", ""),
        database=os.getenv("MYSQL_DATABASE", "tts_bot"),
        cursorclass=pymysql.cursors.DictCursor
    )

def _verify_token_from_db(token: str) -> Optional[dict]:
    """Query token from database"""
    conn = _get_db_connection()
    try:
        with conn.cursor() as c:
            c.execute("""
                SELECT token, group_id, pane_id, perms, expires_at
                FROM tokens
                WHERE token = %s
            """, (token,))
            row = c.fetchone()
            
            if not row:
                return None
            
            # Check expiration
            if row['expires_at'] and row['expires_at'].timestamp() < time.time():
                return None
            
            # Parse perms
            perms = [p.strip() for p in row['perms'].split(',') if p.strip()]
            
            return {
                "valid": True,
                "token": row['token'],
                "group_id": row['group_id'],
                "pane_id": row['pane_id'],
                "perms": perms,
                "expires_at": row['expires_at'].isoformat() if row['expires_at'] else None
            }
    finally:
        conn.close()


# Simple auth check for token management APIs
async def require_api_full(request: Request):
    """Require api_full permission for token management"""
    auth_header = request.headers.get('Authorization', '')
    if not auth_header.startswith('Bearer '):
        raise HTTPException(401, "Authorization required")
    
    token = auth_header[7:]
    result = _verify_token_from_db(token)
    
    if not result or not result.get("valid"):
        raise HTTPException(401, "Invalid token")
    
    if "api_full" not in result.get("perms", []):
        raise HTTPException(403, "api_full permission required")
    
    return result


@router.post("/verify-token")
async def verify_token(request: Request):
    """Verify token and return permissions
    
    Request body: {"token": "..."}
    Response: {"valid": true, "perms": [...], "group_id": ..., "pane_id": ...}
    or {"valid": false}
    
    Uses 30s TTL cache for performance.
    """
    try:
        data = await request.json()
    except:
        raise HTTPException(400, "Invalid JSON")
    
    token = data.get("token")
    if not token:
        raise HTTPException(400, "token required")
    
    # Check cache
    now = time.time()
    if token in _token_cache:
        cached = _token_cache[token]
        if now - cached.get("cached_at", 0) < CACHE_TTL:
            # Return cached result
            result = {k: v for k, v in cached.items() if k != "cached_at"}
            return result
    
    # Query database
    result = _verify_token_from_db(token)
    
    if result:
        # Cache the result
        _token_cache[token] = {**result, "cached_at": now}
        return result
    else:
        # Cache negative result too
        _token_cache[token] = {"valid": False, "cached_at": now}
        return {"valid": False}

@router.post("/flush-cache")
async def flush_cache():
    """Flush token cache (force re-query from DB)"""
    global _token_cache
    _token_cache = {}
    return {"success": True, "message": "Cache flushed"}


# ============================================================================
# Token CRUD (Phase 1 - auth-design.md)
# ============================================================================

from pydantic import BaseModel
from datetime import datetime
import secrets

class TokenCreate(BaseModel):
    group_id: Optional[int] = None
    pane_id: Optional[str] = None
    perms: list[str]
    note: Optional[str] = None
    expires_at: Optional[str] = None  # ISO format datetime

@router.post("/tokens")
async def create_token(data: TokenCreate, request: Request, auth: dict = Depends(require_api_full)):
    """Create a new token
    
    Request body:
    {
        "group_id": 5,  // optional, null = all groups
        "pane_id": "w-20065",  // optional, null = all panes in group
        "perms": ["ttyd_read", "prompt"],
        "note": "客户张三",
        "expires_at": "2026-03-04T00:00:00"  // optional, null = never expires
    }
    
    Returns: {"token": "...", "id": 1}
    """
    # Generate token
    token = secrets.token_hex(32)
    
    # Parse perms
    perms_str = ",".join(data.perms)
    
    conn = _get_db_connection()
    try:
        with conn.cursor() as c:
            c.execute("""
                INSERT INTO tokens (token, group_id, pane_id, perms, note, expires_at)
                VALUES (%s, %s, %s, %s, %s, %s)
            """, (token, data.group_id, data.pane_id, perms_str, data.note, data.expires_at))
            conn.commit()
            token_id = c.lastrowid
        
        return {"token": token, "id": token_id}
    finally:
        conn.close()

@router.get("/tokens")
async def list_tokens(request: Request, auth: dict = Depends(require_api_full)):
    """List all tokens
    
    Returns: {"tokens": [{id, token_prefix, group_id, pane_id, perms, note, expires_at, created_at}]}
    """
    conn = _get_db_connection()
    try:
        with conn.cursor() as c:
            c.execute("""
                SELECT id, CONCAT(LEFT(token, 8), '...') as token_prefix, 
                       group_id, pane_id, perms, note, expires_at, created_at
                FROM tokens
                ORDER BY created_at DESC
            """)
            tokens = c.fetchall()
            
            # Convert datetime to string
            for t in tokens:
                if t['expires_at']:
                    t['expires_at'] = t['expires_at'].isoformat()
                if t['created_at']:
                    t['created_at'] = t['created_at'].isoformat()
            
            return {"tokens": tokens}
    finally:
        conn.close()

@router.delete("/tokens/{token_id}")
async def delete_token(token_id: int, request: Request, auth: dict = Depends(require_api_full)):
    """Delete a token by ID"""
    conn = _get_db_connection()
    try:
        with conn.cursor() as c:
            c.execute("DELETE FROM tokens WHERE id = %s", (token_id,))
            conn.commit()
            
            if c.rowcount == 0:
                raise HTTPException(404, "Token not found")
            
            return {"success": True, "message": f"Token {token_id} deleted"}
    finally:
        conn.close()
